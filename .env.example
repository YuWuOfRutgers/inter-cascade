# Copy to .env (or export in your shell) and fill in the keys you need.
# Only the providers you actually use in your config need a key.

# Weak/strong LLM served by OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...

# Weak/strong LLM served by Google Gemini (API-key mode)
GEMINI_API_KEY=...

# Vertex AI mode for Gemini needs no key here; run instead:
#   gcloud auth application-default login
# and set `project_id` in your YAML config.
